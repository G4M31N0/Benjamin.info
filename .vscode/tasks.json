{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "myhub: serve 8080",
      "type": "shell",
      "command": "python3 -m http.server 8080",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONUNBUFFERED": "1" }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "myhub-http",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving HTTP on",
          "endsPattern": "port 8080 \\(http://0\\.0\\.0\\.0:8080/\\)"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      }
    }
  ]
}
